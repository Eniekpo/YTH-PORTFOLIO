# Server
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Start in mock mode so the app works immediately without external credentials.
# Set to false when you are ready to send real email/WhatsApp messages.
MOCK_MODE=true

# Optional support identity shown in notification content
SUPPORT_NAME=Customer Support
SUPPORT_EMAIL=support@example.com

# SMTP / Email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Customer Support <support@example.com>"

# Meta WhatsApp Cloud API
# Use the Graph API version supported by your Meta app, e.g. v24.0.
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
